# ── Raw data (never commit raw Kaggle download) ───────────────────────────────
data/raw/

# ── Large processed CSV datasets (re-generable via pipeline) ──────────────────
data/processed/*.csv
# Whitelist small evaluation-summary CSVs (not raw datasets)
!data/processed/if_evaluation.csv
!data/processed/injection_evaluation_baseline.csv
!data/processed/injection_train_test_status.csv
!data/processed/injection_log.csv
!data/processed/lstm_evaluation.csv
!data/processed/three_way_comparison.csv
!data/processed/lstm_pr_curve_out.csv
!data/processed/lstm_pr_curve_in.csv
!data/processed/twin_replay_log_out.csv
!data/processed/twin_replay_log_in.csv
!data/processed/twin_crosscheck_report.csv

# ── Models (allow trained H5 weights) ─────────────────────────────────────────
models/*.joblib
!models/*.h5


# ── Python artefacts ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl
*.so

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Kaggle credentials ─────────────────────────────────────────────────────────
kaggle.json
.kaggle/

# ── Scratch / throwaway diagnostics ───────────────────────────────────────────
scratch/

# ── OS & IDE ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
