# ── Raw data (never commit raw Kaggle download) ───────────────────────────────
data/raw/

# ── Large processed CSV datasets (re-generable via pipeline) ──────────────────
data/processed/*.csv

# ── Models (allow trained H5 weights) ─────────────────────────────────────────
models/*.joblib
!models/*.h5


# ── Python artefacts ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl
*.so

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/
.env

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Kaggle credentials ─────────────────────────────────────────────────────────
kaggle.json
.kaggle/

# ── Scratch / throwaway diagnostics ───────────────────────────────────────────
scratch/

# ── OS & IDE ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
